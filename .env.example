# Copy to .env and fill in. Never commit .env.

APP_ENV=dev
LOG_LEVEL=INFO
USER_TIMEZONE=America/Chicago

# From @BotFather in Telegram (step 5)
TELEGRAM_BOT_TOKEN=
DATABASE_URL=postgresql://fuse:fuse@127.0.0.1:55432/fuse
# Your own chat ID (step 5): uv run python -m fuse.channels.whoami
TELEGRAM_ALLOWED_CHAT_ID=0

# LLM providers (step 6). Model ids change: check each provider's console.
LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=openai/gpt-oss-120b

LLM_FALLBACK_BASE_URL=https://api.cerebras.ai/v1
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=gpt-oss-120b

# Google sign-in (step 10)
GOOGLE_CLIENT_SECRETS_FILE=credentials.json
# Encrypts stored Google tokens. Generate once, keep it only in .env:
# uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=